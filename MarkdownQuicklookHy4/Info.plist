<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 扩展的入口全部写在这个 NSExtension 字典里，系统就是靠它找到我们 -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- 这里刻意不写 QLIsDataBasedPreview：写了才是「数据型」（只交一份数据，界面由系统画）。
			     不写 = 视图型，系统会去加载 NSExtensionPrincipalClass 那个 UIViewController -->
			<!-- 声明「我们管这个类型」。net.daringfireball.markdown 就是 .md 文件的标准 UTI -->
			<key>QLSupportedContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
			</array>
			<key>QLSupportsSearchableItems</key>
			<false/>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.preview</string>
		<!-- 视图型的入口是一个 UIViewController（不是 storyboard，视图全在 PreviewViewController 里用代码搭）。
		     $(PRODUCT_MODULE_NAME) 构建时会被换成模块名。想换回「交 HTML」那条路，就把这里改回 PreviewProvider 并在上面加上 QLIsDataBasedPreview -->
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).PreviewViewController</string>
	</dict>
</dict>
</plist>
